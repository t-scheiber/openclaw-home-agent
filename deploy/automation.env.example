# Copy to ~/.config/openclaw/automation.env and set mode 0600.
# Read by the automation units through EnvironmentFile. Nothing here is a real value.

# Number that receives alerts and summaries, in international format.
OPENCLAW_OWNER_PHONE=+10000000000

# Comma-separated repositories the engineering concierge checks.
OPENCLAW_GITHUB_REPOS=example-user/example-repo,example-user/example-app

# Google account the gog CLI uses for the morning brief calendar.
OPENCLAW_GOOGLE_ACCOUNT=user@example.com

# Time zone for the spoken briefing. Defaults to Europe/Berlin.
OPENCLAW_TIMEZONE=Europe/Berlin
