[Unit]
Description=Notify about failed OpenClaw automation %i
After=openclaw-gateway.service

[Service]
Type=oneshot
User=openclaw
Group=openclaw
Environment=HOME=/home/openclaw
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/openclaw/.config/openclaw/automation.env
ExecStart=/usr/bin/openclaw message send --channel whatsapp --target ${OPENCLAW_OWNER_PHONE} --message "OpenClaw automation failed: %i. Check journalctl -u %i."
