# Copy to ~/.config/openclaw/morning-alexa.env and set mode 0600.
# Read by openclaw-alexa-morning.service. Nothing here is a real value.

# TickTick open API token for the task lists named in config/morning-alexa.json.
TICKTICK_ACCESS_TOKEN=

# Fallback coordinates for the weather call when the phone location is unavailable.
# Without them the script uses the Home Assistant forecast instead.
HOME_LATITUDE=
HOME_LONGITUDE=

# Home Assistant add-on SSH access (host, key, person and weather entities).
HOME_ASSISTANT_HOST=192.0.2.30
HOME_ASSISTANT_SSH_KEY=/home/openclaw/.ssh/homeassistant_weather
HOME_ASSISTANT_PERSON_ENTITY=person.owner
HOME_ASSISTANT_WEATHER_ENTITY=weather.forecast_home
