[Unit]
Description=Notify about failed daily digest unit %i
After=openclaw-gateway.service

[Service]
Type=oneshot
User=openclaw
Group=openclaw
Environment=HOME=/home/openclaw
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/openclaw/.openclaw/services/daily-news-digest/.env
ExecStart=/usr/bin/openclaw message send --channel whatsapp --target ${WHATSAPP_TO} --message "OpenClaw alert: the daily news digest failed. Check systemctl status %i and the digest status file."
