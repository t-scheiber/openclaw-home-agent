# Copy to .env (git-ignored) and fill in. Nothing here is a real value.
TZ=Europe/Berlin
DIGEST_OUT_DIR=/home/openclaw/.openclaw/services/daily-news-digest/output
OPENCLAW_WORKSPACE=/home/openclaw/.openclaw/workspace

# Optional local news sections. Leave empty to skip them.
DIGEST_COUNTRY=
DIGEST_COUNTRY_CODE=
DIGEST_CITY=

# Optional but recommended. Without this, the digest uses extractive summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Google Drive upload through rclone.
# Example after configuring an rclone remote named gdrive:
# RCLONE_REMOTE_PATH=gdrive:Speechify/Daily News Digest
RCLONE_REMOTE_PATH=

# Optional public/shared folder URL. Used only in the email text.
PUBLIC_DIGEST_BASE_URL=

# Nodemailer SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=agent@example.com
SMTP_PASS=
MAIL_FROM=agent@example.com
MAIL_TO=user@example.com

# Set true if you want the PDF attached as well as uploaded.
EMAIL_ATTACH_PDF=false
MIN_DIGEST_ITEMS=5
EXCLUDE_TITLE_PATTERNS=prime day|black friday|best deals|deal of the day|discounted

# WhatsApp notification through the OpenClaw CLI. Also used by the failure unit.
WHATSAPP_NOTIFY=true
WHATSAPP_TO=+10000000000

# Optional copy of the PDF into an Obsidian vault.
OBSIDIAN_VAULT_DIR=/home/openclaw/Obsidian/Vault
OBSIDIAN_SPEECHIFY_SUBDIR=Daily/Speechify
